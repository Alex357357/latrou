<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NOVA VISION — L'innovation numérique à votre portée</title>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
  <!-- Tailwind CSS via CDN + custom base -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
          colors: {
            nova: {
              deep: '#0B1E33',      // deep blue
              navy: '#112B4F',
              steel: '#1E3A5F',
              accent: '#2A7FFF',    // vibrant tech blue
              soft: '#F0F4FA',
              grey: '#64748B'
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Smooth scrolling handled by class on html, but also fallback */
    html { scroll-behavior: smooth; }
    /* subtle custom shadow for sticky header */
    .nova-shadow {
      box-shadow: 0 8px 20px -8px rgba(0, 30, 60, 0.12);
    }
    /* active navigation link style */
    .nav-link.active {
      color: #2A7FFF;
      font-weight: 600;
    }
    /* portfolio image placeholder – clean gradient with tech pattern */
    .portfolio-placeholder {
      background: linear-gradient(145deg, #112B4F 0%, #1E3A5F 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #E2E8F0;
      font-weight: 300;
      letter-spacing: 0.5px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .portfolio-placeholder:hover {
      transform: scale(1.01);
      box-shadow: 0 20px 30px -12px rgba(0,0,0,0.3);
    }
    /* custom underline effect for nav links on hover */
    .nav-link {
      position: relative;
    }
    .nav-link::after {
      content: '';
      position: absolute;
      width: 0;
      height: 2px;
      bottom: -4px;
      left: 0;
      background-color: #2A7FFF;
      transition: width 0.2s ease;
    }
    .nav-link:hover::after {
      width: 100%;
    }
    .nav-link.active::after {
      width: 100%;
    }
    /* subtle entry animation for hero */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
      animation: fadeUp 0.8s ease forwards;
    }
    .delay-100 { animation-delay: 0.1s; }
    .delay-200 { animation-delay: 0.2s; }
  </style>
</head>
<body class="bg-white text-nova-deep font-sans antialiased selection:bg-nova-accent/20">

  <!-- ==================== STICKY HEADER ==================== -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm nova-shadow border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16 md:h-20">
        <!-- Logo / Company name -->
        <a href="#" class="text-2xl md:text-3xl font-extrabold tracking-tight text-nova-deep flex items-center gap-2">
          <span class="bg-nova-accent text-white w-8 h-8 rounded-lg flex items-center justify-center text-lg font-bold">N</span>
          NOVA<span class="text-nova-accent font-light">VISION</span>
        </a>

        <!-- Desktop navigation -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-nova-grey">
          <a href="#home" class="nav-link hover:text-nova-accent transition-colors">Accueil</a>
          <a href="#services" class="nav-link hover:text-nova-accent transition-colors">Services</a>
          <a href="#portfolio" class="nav-link hover:text-nova-accent transition-colors">Portfolio</a>
          <a href="#about" class="nav-link hover:text-nova-accent transition-colors">À propos</a>
          <a href="#contact" class="nav-link hover:text-nova-accent transition-colors">Contact</a>
        </nav>

        <!-- Mobile menu button -->
        <button id="menuBtn" class="md:hidden p-2 rounded-md text-nova-deep hover:bg-gray-100 focus:outline-none transition" aria-label="Menu principal">
          <svg id="menuIconOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menuIconClose" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu panel (hidden by default) -->
    <div id="mobileMenu" class="hidden md:hidden bg-white border-t border-gray-100 py-4 px-4 shadow-lg">
      <nav class="flex flex-col space-y-3 text-base font-medium text-nova-grey">
        <a href="#home" class="mobile-link px-3 py-2 rounded-lg hover:bg-nova-soft hover:text-nova-accent transition">Accueil</a>
        <a href="#services" class="mobile-link px-3 py-2 rounded-lg hover:bg-nova-soft hover:text-nova-accent transition">Services</a>
        <a href="#portfolio" class="mobile-link px-3 py-2 rounded-lg hover:bg-nova-soft hover:text-nova-accent transition">Portfolio</a>
        <a href="#about" class="mobile-link px-3 py-2 rounded-lg hover:bg-nova-soft hover:text-nova-accent transition">À propos</a>
        <a href="#contact" class="mobile-link px-3 py-2 rounded-lg hover:bg-nova-soft hover:text-nova-accent transition">Contact</a>
      </nav>
    </div>
  </header>

  <!-- ==================== HERO SECTION ==================== -->
  <section id="home" class="relative bg-gradient-to-br from-nova-deep via-nova-navy to-nova-steel text-white overflow-hidden">
    <!-- subtle grid pattern overlay -->
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 lg:py-40">
      <div class="max-w-3xl">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold leading-tight tracking-tight animate-fade-up">
          NOVA VISION : <span class="text-nova-accent">L'innovation numérique</span> à votre portée
        </h1>
        <p class="mt-6 text-lg md:text-xl text-gray-200 max-w-2xl leading-relaxed animate-fade-up delay-100">
          Nous concevons des applications mobiles Android performantes et des solutions digitales sur mesure pour propulser votre entreprise au Burkina Faso.
        </p>
        <div class="mt-10 animate-fade-up delay-200">
          <a href="#services" class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-full bg-nova-accent text-white hover:bg-blue-600 transition shadow-lg shadow-blue-900/30 hover:shadow-xl transform hover:-translate-y-0.5">
            Découvrir nos Services
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
    <!-- bottom wave for smooth transition (optional) -->
    <div class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-white to-transparent opacity-10"></div>
  </section>

  <!-- ==================== SERVICES ==================== -->
  <section id="services" class="py-20 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-nova-accent font-semibold text-sm uppercase tracking-widest">Nos expertises</span>
        <h2 class="text-3xl md:text-4xl font-bold mt-3 text-nova-deep">Des solutions digitales qui font la différence</h2>
        <p class="mt-4 text-nova-grey text-lg">Nous allions créativité technique et compréhension métier pour bâtir des outils performants et évolutifs.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Service 1 -->
        <div class="bg-nova-soft/60 rounded-2xl p-8 border border-gray-100 hover:border-nova-accent/30 hover:shadow-lg transition-all duration-300 group">
          <div class="w-14 h-14 rounded-xl bg-nova-accent/10 text-nova-accent flex items-center justify-center mb-6 group-hover:bg-nova-accent group-hover:text-white transition">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-nova-deep">Développement Mobile Android</h3>
          <p class="mt-3 text-nova-grey leading-relaxed">Applications natives, intuitives et performantes, optimisées pour l'écosystème Android.</p>
        </div>
        <!-- Service 2 -->
        <div class="bg-nova-soft/60 rounded-2xl p-8 border border-gray-100 hover:border-nova-accent/30 hover:shadow-lg transition-all duration-300 group">
          <div class="w-14 h-14 rounded-xl bg-nova-accent/10 text-nova-accent flex items-center justify-center mb-6 group-hover:bg-nova-accent group-hover:text-white transition">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-nova-deep">Solutions Numériques sur Mesure</h3>
          <p class="mt-3 text-nova-grey leading-relaxed">Logiciels et plateformes conçus pour répondre précisément à vos besoins spécifiques.</p>
        </div>
        <!-- Service 3 -->
        <div class="bg-nova-soft/60 rounded-2xl p-8 border border-gray-100 hover:border-nova-accent/30 hover:shadow-lg transition-all duration-300 group">
          <div class="w-14 h-14 rounded-xl bg-nova-accent/10 text-nova-accent flex items-center justify-center mb-6 group-hover:bg-nova-accent group-hover:text-white transition">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-nova-deep">Conseil Digital</h3>
          <p class="mt-3 text-nova-grey leading-relaxed">Nous vous guidons dans votre transformation digitale et votre stratégie technologique.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PORTFOLIO ==================== -->
  <section id="portfolio" class="py-20 md:py-28 bg-nova-soft/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-nova-accent font-semibold text-sm uppercase tracking-widest">Réalisations</span>
        <h2 class="text-3xl md:text-4xl font-bold mt-3 text-nova-deep">Nos projets récents</h2>
        <p class="mt-4 text-nova-grey text-lg">Découvrez une sélection de solutions que nous avons développées pour nos clients.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Projet 1 -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow duration-300 border border-gray-100">
          <div class="portfolio-placeholder h-56 w-full flex items-center justify-center text-4xl">
            📱
          </div>
          <div class="p-6 md:p-8">
            <h3 class="text-2xl font-bold text-nova-deep">Prono Master : Pmu et sport</h3>
            <p class="mt-3 text-nova-grey leading-relaxed">Application d'aide à la prédiction, intégrant Firebase et SebPay Africa pour des paiements sécurisés et une expérience utilisateur fluide.</p>
            <div class="mt-5 flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-nova-accent/10 text-nova-accent text-xs font-semibold rounded-full">Android</span>
              <span class="px-3 py-1 bg-nova-accent/10 text-nova-accent text-xs font-semibold rounded-full">Firebase</span>
              <span class="px-3 py-1 bg-nova-accent/10 text-nova-accent text-xs font-semibold rounded-full">SebPay</span>
            </div>
          </div>
        </div>
        <!-- Projet 2 -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow duration-300 border border-gray-100">
          <div class="portfolio-placeholder h-56 w-full flex items-center justify-center text-4xl">
            🎓
          </div>
          <div class="p-6 md:p-8">
            <h3 class="text-2xl font-bold text-nova-deep">Mon Cours Digital</h3>
            <p class="mt-3 text-nova-grey leading-relaxed">Plateforme d'apprentissage en ligne innovante, pensée pour rendre l'éducation accessible et interactive partout au Burkina Faso.</p>
            <div class="mt-5 flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-nova-accent/10 text-nova-accent text-xs font-semibold rounded-full">E-learning</span>
              <span class="px-3 py-1 bg-nova-accent/10 text-nova-accent text-xs font-semibold rounded-full">Web</span>
              <span class="px-3 py-1 bg-nova-accent/10 text-nova-accent text-xs font-semibold rounded-full">Mobile</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== ABOUT ==================== -->
  <section id="about" class="py-20 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-nova-accent font-semibold text-sm uppercase tracking-widest">Qui sommes-nous</span>
          <h2 class="text-3xl md:text-4xl font-bold mt-3 text-nova-deep">La vision d'Ibrahim CONGO</h2>
          <div class="mt-6 space-y-4 text-nova-grey leading-relaxed text-base md:text-lg">
            <p>
              Chez <strong class="text-nova-deep">NOVA VISION</strong>, nous croyons que la technologie doit être un levier de croissance accessible à toutes les entreprises burkinabè. 
              Fondée à Ouagadougou, notre startup s'engage à fournir des solutions numériques de haute qualité, pensées localement et compétitives à l'international.
            </p>
            <p>
              Sous l'impulsion d'<strong class="text-nova-deep">Ibrahim CONGO</strong>, notre fondateur, nous mettons notre expertise technique au service de votre réussite. 
              Chaque projet est unique, et nous y consacrons toute notre rigueur et notre passion pour l'innovation.
            </p>
          </div>
          <div class="mt-8 flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-nova-accent/10 flex items-center justify-center text-nova-accent font-bold text-xl">IC</div>
            <div>
              <p class="font-semibold text-nova-deep">Ibrahim CONGO</p>
              <p class="text-sm text-nova-grey">Fondateur & Directeur Technique</p>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-br from-nova-deep to-nova-navy rounded-2xl p-8 text-white shadow-xl relative overflow-hidden">
          <div class="absolute top-0 right-0 w-40 h-40 bg-nova-accent/20 rounded-full -mr-10 -mt-10"></div>
          <div class="absolute bottom-0 left-0 w-32 h-32 bg-white/5 rounded-full -ml-8 -mb-8"></div>
          <svg class="w-12 h-12 text-nova-accent mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <p class="text-xl italic font-light leading-relaxed text-gray-100">
            « Notre mission est de prouver que le Burkina Faso peut produire des solutions digitales de classe mondiale. Chaque ligne de code que nous écrivons porte cette ambition. »
          </p>
          <p class="mt-6 text-nova-accent font-medium">— Ibrahim CONGO</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CONTACT ==================== -->
  <section id="contact" class="py-20 md:py-28 bg-nova-soft/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-nova-accent font-semibold text-sm uppercase tracking-widest">Contactez-nous</span>
        <h2 class="text-3xl md:text-4xl font-bold mt-3 text-nova-deep">Parlons de votre projet</h2>
        <p class="mt-4 text-nova-grey text-lg">Une idée, un besoin ? Écrivez-nous, nous vous répondrons dans les plus brefs délais.</p>
      </div>

      <div class="grid md:grid-cols-5 gap-10">
        <!-- Contact form -->
        <div class="md:col-span-3 bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-gray-100">
          <form id="contactForm" class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium text-nova-deep mb-1">Nom complet</label>
              <input type="text" id="name" name="name" required
                     class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-nova-accent focus:ring-2 focus:ring-nova-accent/20 outline-none transition bg-nova-soft/30"
                     placeholder="Votre nom">
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-nova-deep mb-1">Email</label>
              <input type="email" id="email" name="email" required
                     class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-nova-accent focus:ring-2 focus:ring-nova-accent/20 outline-none transition bg-nova-soft/30"
                     placeholder="vous@exemple.com">
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-nova-deep mb-1">Message</label>
              <textarea id="message" name="message" rows="5" required
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-nova-accent focus:ring-2 focus:ring-nova-accent/20 outline-none transition bg-nova-soft/30 resize-y"
                        placeholder="Décrivez votre projet..."></textarea>
            </div>
            <button type="submit"
                    class="w-full md:w-auto inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold rounded-xl bg-nova-accent text-white hover:bg-blue-600 transition shadow-md shadow-blue-900/10 hover:shadow-lg">
              Envoyer le message
              <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
            <!-- Confirmation message (hidden by default) -->
            <div id="formFeedback" class="hidden mt-4 p-4 rounded-xl bg-green-50 text-green-700 border border-green-200 text-sm font-medium">
              ✅ Merci ! Votre message a bien été envoyé. Nous vous contacterons rapidement.
            </div>
          </form>
        </div>

        <!-- Contact info -->
        <div class="md:col-span-2 space-y-6">
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-nova-accent/10 text-nova-accent flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-nova-deep">Email</p>
              <a href="mailto:informatique7092@gmail.com" class="text-nova-grey hover:text-nova-accent transition break-all">informatique7092@gmail.com</a>
            </div>
          </div>
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-nova-accent/10 text-nova-accent flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-nova-deep">Téléphone</p>
              <a href="tel:+22669093386" class="text-nova-grey hover:text-nova-accent transition">+226 69093386</a>
            </div>
          </div>
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-nova-accent/10 text-nova-accent flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-nova-deep">Adresse</p>
              <p class="text-nova-grey">Bâtiment 12, Avenue Babanguida, Ouagadougou, Burkina Faso</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FOOTER ==================== -->
  <footer class="bg-nova-deep text-gray-300 py-12 border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
